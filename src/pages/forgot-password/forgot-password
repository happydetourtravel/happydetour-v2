import { useState } from 'react'
import { useSignIn } from '@clerk/clerk-react'
import { useNavigate } from 'react-router-dom'

export default function ForgotPasswordForm() {
  const { signIn, isLoaded, setActive } = useSignIn()
  const navigate = useNavigate()

  const [step, setStep] = useState<'email' | 'reset'>('email')
  const [email, setEmail] = useState('')
  const [code, setCode] = useState('')
  const [password, setPassword] = useState('')
  const [error, setError] = useState('')
  const [loading, setLoading] = useState(false)

  // Step 1: send the reset code to their email
  const handleSendCode = async (e: React.FormEvent) => {
    e.preventDefault()
    setError('')
    if (!isLoaded) return
    setLoading(true)

    try {
      await signIn.create({
        strategy: 'reset_password_email_code',
        identifier: email,
      })
      setStep('reset')
    } catch (err: any) {
      setError(err?.errors?.[0]?.message || 'We couldn\u2019t find an account with that email. Please check it and try again.')
    } finally {
      setLoading(false)
    }
  }

  // Step 2: check the code and save the new password
  const handleReset = async (e: React.FormEvent) => {
    e.preventDefault()
    setError('')
    if (!isLoaded) return
    setLoading(true)

    try {
      const result = await signIn.attemptFirstFactor({
        strategy: 'reset_password_email_code',
        code,
        password,
      })

      if (result.status === 'complete') {
        await setActive({ session: result.createdSessionId })
        navigate('/members')
      } else {
        setError('Your password was updated, but we need one more step. Please sign in on the login page.')
      }
    } catch (err: any) {
      setError(err?.errors?.[0]?.message || 'That code didn\u2019t work. Please check it and try again.')
    } finally {
      setLoading(false)
    }
  }

  const inputStyle = {
    width: '100%',
    padding: '10px 14px',
    borderRadius: '8px',
    border: '1px solid #D1D5DB',
    fontSize: '14px',
    outline: 'none',
    boxSizing: 'border-box' as const,
  }

  const labelStyle = {
    display: 'block',
    color: '#374151',
    fontSize: '13px',
    fontWeight: '600',
    marginBottom: '6px',
  }

  const buttonStyle = {
    backgroundColor: loading ? '#9CA3AF' : '#F59E0B',
    color: 'white',
    padding: '14px',
    borderRadius: '8px',
    border: 'none',
    fontSize: '16px',
    fontWeight: '700',
    cursor: loading ? 'not-allowed' : 'pointer',
    marginTop: '8px',
  }

  return (
    <div style={{ minHeight: '100vh', backgroundColor: '#F9FAFB', fontFamily: 'sans-serif', display: 'flex', alignItems: 'center', justifyContent: 'center', padding: '40px 16px' }}>
      <div style={{ maxWidth: '440px', width: '100%', backgroundColor: 'white', borderRadius: '16px', border: '1px solid #E5E7EB', boxShadow: '0 4px 24px rgba(0,0,0,0.06)', overflow: 'hidden' }}>

        {/* Top banner */}
        <div style={{ backgroundColor: '#007298', padding: '28px 28px 22px' }}>
          <p style={{ color: '#F59E0B', fontSize: '12px', fontWeight: '700', letterSpacing: '2px', textTransform: 'uppercase', margin: '0 0 8px 0' }}>
            Happy Detour Travel
          </p>
          <h1 style={{ color: 'white', fontSize: '24px', fontWeight: '800', margin: '0 0 6px 0', lineHeight: '1.3' }}>
            {step === 'email' ? 'Forgot your password?' : 'Check your email'}
          </h1>
          <p style={{ color: 'rgba(255,255,255,0.85)', fontSize: '14px', lineHeight: '1.6', margin: 0 }}>
            {step === 'email'
              ? 'No problem. Enter your email and we\u2019ll send you a code to reset it.'
              : `We sent a code to ${email}. Enter it below and choose a new password.`}
          </p>
        </div>

        <div style={{ padding: '28px' }}>
          {error && (
            <div style={{ backgroundColor: '#FEF2F2', border: '1px solid #FCA5A5', borderRadius: '8px', padding: '12px 16px', marginBottom: '20px' }}>
              <p style={{ color: '#DC2626', fontSize: '14px', margin: 0 }}>{error}</p>
            </div>
          )}

          {step === 'email' ? (
            <form onSubmit={handleSendCode} style={{ display: 'flex', flexDirection: 'column', gap: '16px' }}>
              <div>
                <label style={labelStyle}>Email Address *</label>
                <input
                  type="email"
                  value={email}
                  onChange={(e) => setEmail(e.target.value)}
                  required
                  placeholder="you@email.com"
                  style={inputStyle}
                />
              </div>
              <button type="submit" disabled={loading} style={buttonStyle}>
                {loading ? 'Sending...' : 'Send Reset Code'}
              </button>
            </form>
          ) : (
            <form onSubmit={handleReset} style={{ display: 'flex', flexDirection: 'column', gap: '16px' }}>
              <div>
                <label style={labelStyle}>Code From Your Email *</label>
                <input
                  type="text"
                  inputMode="numeric"
                  autoComplete="one-time-code"
                  value={code}
                  onChange={(e) => setCode(e.target.value)}
                  required
                  placeholder="6-digit code"
                  style={inputStyle}
                />
              </div>
              <div>
                <label style={labelStyle}>New Password *</label>
                <input
                  type="password"
                  autoComplete="new-password"
                  value={password}
                  onChange={(e) => setPassword(e.target.value)}
                  required
                  placeholder="Choose a new password"
                  style={inputStyle}
                />
              </div>
              <button type="submit" disabled={loading} style={buttonStyle}>
                {loading ? 'Saving...' : 'Reset Password'}
              </button>
              <button
                type="button"
                onClick={() => { setStep('email'); setCode(''); setPassword(''); setError('') }}
                style={{ background: 'none', border: 'none', color: '#007298', fontSize: '13px', fontWeight: '600', cursor: 'pointer', padding: 0 }}
              >
                Didn&rsquo;t get it? Try a different email or resend
              </button>
            </form>
          )}

          <p style={{ color: '#6B7280', fontSize: '14px', textAlign: 'center', margin: '24px 0 0 0' }}>
            Remembered it?{' '}
            <a href="/login" style={{ color: '#007298', fontWeight: '600', textDecoration: 'none' }}>Back to sign in</a>
          </p>
        </div>
      </div>
    </div>
  )
}
